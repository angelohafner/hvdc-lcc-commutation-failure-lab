  <definitions>
    <Definition classid="UserCmpDefn" name="LabController" id="1037986117">
      <paramlist>
        <param name="Description" value="Original LCC source profiles and firing clock" />
      </paramlist>
      <form name="Lab Controller" w="600" h="600">
        <category name="Configuration">
          <cond>true</cond>
          <parameter type="Real" name="frequency_hz" desc="frequency hz" content_type="Constant" min="-1E30" max="1E30" unit="" intent="Input" dim="1">
            <value>50.0</value>
            <cond type="Enable">true</cond>
          </parameter>
          <parameter type="Real" name="ac_voltage_v" desc="ac voltage v" content_type="Constant" min="-1E30" max="1E30" unit="" intent="Input" dim="1">
            <value>100000.0</value>
            <cond type="Enable">true</cond>
          </parameter>
          <parameter type="Real" name="dc_voltage_v" desc="dc voltage v" content_type="Constant" min="-1E30" max="1E30" unit="" intent="Input" dim="1">
            <value>118000.0</value>
            <cond type="Enable">true</cond>
          </parameter>
          <parameter type="Real" name="dc_resistance_ohm" desc="dc resistance ohm" content_type="Constant" min="-1E30" max="1E30" unit="" intent="Input" dim="1">
            <value>5.0</value>
            <cond type="Enable">true</cond>
          </parameter>
          <parameter type="Real" name="smoothing_h" desc="smoothing h" content_type="Constant" min="-1E30" max="1E30" unit="" intent="Input" dim="1">
            <value>0.5</value>
            <cond type="Enable">true</cond>
          </parameter>
          <parameter type="Real" name="grid_resistance_ohm" desc="grid resistance ohm" content_type="Constant" min="-1E30" max="1E30" unit="" intent="Input" dim="1">
            <value>0.3</value>
            <cond type="Enable">true</cond>
          </parameter>
          <parameter type="Real" name="grid_inductance_h" desc="grid inductance h" content_type="Constant" min="-1E30" max="1E30" unit="" intent="Input" dim="1">
            <value>0.01</value>
            <cond type="Enable">true</cond>
          </parameter>
          <parameter type="Real" name="commutation_h" desc="commutation h" content_type="Constant" min="-1E30" max="1E30" unit="" intent="Input" dim="1">
            <value>0.01</value>
            <cond type="Enable">true</cond>
          </parameter>
          <parameter type="Real" name="alpha_deg" desc="alpha deg" content_type="Constant" min="-1E30" max="1E30" unit="" intent="Input" dim="1">
            <value>140.0</value>
            <cond type="Enable">true</cond>
          </parameter>
          <parameter type="Real" name="recovery_us" desc="recovery us" content_type="Constant" min="-1E30" max="1E30" unit="" intent="Input" dim="1">
            <value>200.0</value>
            <cond type="Enable">true</cond>
          </parameter>
          <parameter type="Real" name="fault_start_s" desc="fault start s" content_type="Constant" min="-1E30" max="1E30" unit="" intent="Input" dim="1">
            <value>0.3</value>
            <cond type="Enable">true</cond>
          </parameter>
          <parameter type="Real" name="fault_duration_s" desc="fault duration s" content_type="Constant" min="-1E30" max="1E30" unit="" intent="Input" dim="1">
            <value>0.08</value>
            <cond type="Enable">true</cond>
          </parameter>
          <parameter type="Real" name="sag_pu" desc="sag pu" content_type="Constant" min="-1E30" max="1E30" unit="" intent="Input" dim="1">
            <value>1.0</value>
            <cond type="Enable">true</cond>
          </parameter>
          <parameter type="Real" name="phase_jump_deg" desc="phase jump deg" content_type="Constant" min="-1E30" max="1E30" unit="" intent="Input" dim="1">
            <value>0.0</value>
            <cond type="Enable">true</cond>
          </parameter>
          <parameter type="Real" name="dc_step_pu" desc="dc step pu" content_type="Constant" min="-1E30" max="1E30" unit="" intent="Input" dim="1">
            <value>1.0</value>
            <cond type="Enable">true</cond>
          </parameter>
          <parameter type="Real" name="harmonic_pu" desc="harmonic pu" content_type="Constant" min="-1E30" max="1E30" unit="" intent="Input" dim="1">
            <value>0.0</value>
            <cond type="Enable">true</cond>
          </parameter>
          <parameter type="Real" name="fault_type" desc="fault type" content_type="Constant" min="-1E30" max="1E30" unit="" intent="Input" dim="1">
            <value>0</value>
            <cond type="Enable">true</cond>
          </parameter>
          <parameter type="Real" name="fault_resistance_ohm" desc="fault resistance ohm" content_type="Constant" min="-1E30" max="1E30" unit="" intent="Input" dim="1">
            <value>2.0</value>
            <cond type="Enable">true</cond>
          </parameter>
          <parameter type="Real" name="alpha_event_deg" desc="alpha event deg" content_type="Constant" min="-1E30" max="1E30" unit="" intent="Input" dim="1">
            <value>140.0</value>
            <cond type="Enable">true</cond>
          </parameter>
          <parameter type="Real" name="dc_reduce_pu" desc="dc reduce pu" content_type="Constant" min="-1E30" max="1E30" unit="" intent="Input" dim="1">
            <value>1.0</value>
            <cond type="Enable">true</cond>
          </parameter>
          <parameter type="Real" name="recovery_sag_pu" desc="recovery sag pu" content_type="Constant" min="-1E30" max="1E30" unit="" intent="Input" dim="1">
            <value>1.0</value>
            <cond type="Enable">true</cond>
          </parameter>
          <parameter type="Real" name="recovery_sag_duration_s" desc="recovery sag duration s" content_type="Constant" min="-1E30" max="1E30" unit="" intent="Input" dim="1">
            <value>0.0</value>
            <cond type="Enable">true</cond>
          </parameter>
          <parameter type="Real" name="duration_s" desc="duration s" content_type="Constant" min="-1E30" max="1E30" unit="" intent="Input" dim="1">
            <value>0.6</value>
            <cond type="Enable">true</cond>
          </parameter>
          <parameter type="Real" name="time_step_us" desc="time step us" content_type="Constant" min="-1E30" max="1E30" unit="" intent="Input" dim="1">
            <value>10.0</value>
            <cond type="Enable">true</cond>
          </parameter>
          <parameter type="Text" name="G1" desc="Output G1" allowemptystr="false">
            <value>G1</value>
            <cond type="Enable">true</cond>
          </parameter>
          <parameter type="Text" name="G2" desc="Output G2" allowemptystr="false">
            <value>G2</value>
            <cond type="Enable">true</cond>
          </parameter>
          <parameter type="Text" name="G3" desc="Output G3" allowemptystr="false">
            <value>G3</value>
            <cond type="Enable">true</cond>
          </parameter>
          <parameter type="Text" name="G4" desc="Output G4" allowemptystr="false">
            <value>G4</value>
            <cond type="Enable">true</cond>
          </parameter>
          <parameter type="Text" name="G5" desc="Output G5" allowemptystr="false">
            <value>G5</value>
            <cond type="Enable">true</cond>
          </parameter>
          <parameter type="Text" name="G6" desc="Output G6" allowemptystr="false">
            <value>G6</value>
            <cond type="Enable">true</cond>
          </parameter>
          <parameter type="Text" name="EA" desc="Output EA" allowemptystr="false">
            <value>EA</value>
            <cond type="Enable">true</cond>
          </parameter>
          <parameter type="Text" name="EB" desc="Output EB" allowemptystr="false">
            <value>EB</value>
            <cond type="Enable">true</cond>
          </parameter>
          <parameter type="Text" name="EC" desc="Output EC" allowemptystr="false">
            <value>EC</value>
            <cond type="Enable">true</cond>
          </parameter>
          <parameter type="Text" name="EDC" desc="Output EDC" allowemptystr="false">
            <value>EDC</value>
            <cond type="Enable">true</cond>
          </parameter>
          <parameter type="Text" name="AlphaRef" desc="Output AlphaRef" allowemptystr="false">
            <value>AlphaRef</value>
            <cond type="Enable">true</cond>
          </parameter>
          <parameter type="Text" name="FaultActive" desc="Output FaultActive" allowemptystr="false">
            <value>FaultActive</value>
            <cond type="Enable">true</cond>
          </parameter>
          <parameter type="Text" name="SagApplied" desc="Output SagApplied" allowemptystr="false">
            <value>SagApplied</value>
            <cond type="Enable">true</cond>
          </parameter>
          <parameter type="Text" name="FA" desc="Output FA" allowemptystr="false">
            <value>FA</value>
            <cond type="Enable">true</cond>
          </parameter>
          <parameter type="Text" name="FB" desc="Output FB" allowemptystr="false">
            <value>FB</value>
            <cond type="Enable">true</cond>
          </parameter>
          <parameter type="Text" name="FC" desc="Output FC" allowemptystr="false">
            <value>FC</value>
            <cond type="Enable">true</cond>
          </parameter>
          <parameter type="Text" name="FAB" desc="Output FAB" allowemptystr="false">
            <value>FAB</value>
            <cond type="Enable">true</cond>
          </parameter>
        </category>
      </form>
      <graphics size="4">
        <paramlist>
          <param name="show_border" value="0" />
          <param name="lock_style" value="3" />
          <param name="lock_cx" value="0" />
          <param name="lock_cy" value="0" />
        </paramlist>
      </graphics>
      <script>
        <segment name="Fortran" classid="CoreSegment" id="1534296336"><![CDATA[#LOCAL REAL TH
#LOCAL REAL SAG
#LOCAL REAL EVENT
#LOCAL REAL ALPHA
#LOCAL REAL PHASE
#LOCAL REAL DCFACTOR
#LOCAL REAL RAMP
#LOCAL REAL VA
#LOCAL REAL VB
#LOCAL REAL VC
#LOCAL REAL VD
#LOCAL REAL HARM
#LOCAL INTEGER GA
#LOCAL INTEGER GB
#LOCAL INTEGER GC
#LOCAL INTEGER GAB
      TH = TIME * 360.0 * $frequency_hz
      EVENT = 0.0
      IF (TIME .GE. $fault_start_s .AND.
     + TIME .LT. ($fault_start_s+$fault_duration_s)) EVENT=1.0
      SAG = 1.0 + EVENT * ($sag_pu-1.0)
      PHASE = EVENT * $phase_jump_deg
      ALPHA = $alpha_deg + EVENT*($alpha_event_deg-$alpha_deg)
      DCFACTOR=1.0+EVENT*($dc_step_pu*$dc_reduce_pu-1.0)
      RAMP=MIN(1.0, MAX(0.0,(TIME-0.02)/0.08))
      HARM=EVENT*$harmonic_pu
      VA=$ac_voltage_v/1000.0*SQRT(2.0/3.0)
     + *(SAG*SIN((TH+PHASE)*PI_BY180)
     + + HARM*SIN(5.0*TH*PI_BY180))
      VB=$ac_voltage_v/1000.0*SQRT(2.0/3.0)
     + *(SAG*SIN((TH-120.0+PHASE)*PI_BY180)
     + + HARM*SIN(5.0*(TH-120.0)*PI_BY180))
      VC=$ac_voltage_v/1000.0*SQRT(2.0/3.0)
     + *(SAG*SIN((TH+120.0+PHASE)*PI_BY180)
     + + HARM*SIN(5.0*(TH+120.0)*PI_BY180))
      VD=-$dc_voltage_v/1000.0*DCFACTOR*RAMP
      GA=0
      GB=0
      GC=0
      GAB=0
      IF (EVENT .GT. 0.5) THEN
        IF (NINT($fault_type).EQ.1) GA=1
        IF (NINT($fault_type).EQ.2) GAB=1
        IF (NINT($fault_type).EQ.3) THEN
          GB=1
          GC=1
        ENDIF
        IF (NINT($fault_type).EQ.4) THEN
          GA=1
          GB=1
          GC=1
        ENDIF
      ENDIF
#LOCAL INTEGER IG1
      IG1=0
      IF (MODULO(TH-30.0-ALPHA-0.0,360.0)
     + .LT. 120.0 .AND. TIME.GE.0.02) IG1=1
#OUTPUT INTEGER G1 {IG1}
#LOCAL INTEGER IG2
      IG2=0
      IF (MODULO(TH-30.0-ALPHA-60.0,360.0)
     + .LT. 120.0 .AND. TIME.GE.0.02) IG2=1
#OUTPUT INTEGER G2 {IG2}
#LOCAL INTEGER IG3
      IG3=0
      IF (MODULO(TH-30.0-ALPHA-120.0,360.0)
     + .LT. 120.0 .AND. TIME.GE.0.02) IG3=1
#OUTPUT INTEGER G3 {IG3}
#LOCAL INTEGER IG4
      IG4=0
      IF (MODULO(TH-30.0-ALPHA-180.0,360.0)
     + .LT. 120.0 .AND. TIME.GE.0.02) IG4=1
#OUTPUT INTEGER G4 {IG4}
#LOCAL INTEGER IG5
      IG5=0
      IF (MODULO(TH-30.0-ALPHA-240.0,360.0)
     + .LT. 120.0 .AND. TIME.GE.0.02) IG5=1
#OUTPUT INTEGER G5 {IG5}
#LOCAL INTEGER IG6
      IG6=0
      IF (MODULO(TH-30.0-ALPHA-300.0,360.0)
     + .LT. 120.0 .AND. TIME.GE.0.02) IG6=1
#OUTPUT INTEGER G6 {IG6}
#OUTPUT REAL EA {VA}
#OUTPUT REAL EB {VB}
#OUTPUT REAL EC {VC}
#OUTPUT REAL EDC {VD}
#OUTPUT REAL AlphaRef {ALPHA}
#OUTPUT REAL FaultActive {EVENT}
#OUTPUT REAL SagApplied {SAG}
#OUTPUT INTEGER FA {GA}
#OUTPUT INTEGER FB {GB}
#OUTPUT INTEGER FC {GC}
#OUTPUT INTEGER FAB {GAB}]]></segment>
      </script>
    </Definition>
